@echo off
setlocal
title Sophia - install
cd /d "%~dp0"
echo.
echo   Sophia - one file installer
echo   ==========================
echo.
echo   This single file IS Sophia. It will:
echo     - put her in a folder you choose (it looks for your delivery app first)
echo     - keep a backup of your old assistant.html
echo     - put a "Sophia" shortcut on your Desktop
echo.
echo   Nothing is uploaded. Nothing is deleted.
echo.
set "OUT=%USERPROFILE%\Sophia"
for %%D in ("%USERPROFILE%\Desktop\DELIVERY APP STUFF" "%USERPROFILE%\Documents\DELIVERY APP STUFF") do (
  if exist "%%~D\index.html" set "OUT=%%~D"
)
echo   Sophia will be installed in:
echo     "%OUT%"
echo.
set /p CHANGE="   Press Enter to accept, or type another folder path: "
if not "%CHANGE%"=="" set "OUT=%CHANGE%"
if not exist "%OUT%" mkdir "%OUT%"
if exist "%OUT%\assistant.html" copy /y "%OUT%\assistant.html" "%OUT%\assistant-old.html" >nul
where certutil >nul 2>nul
if errorlevel 1 goto NOCERTUTIL
echo.
echo   Unpacking Sophia, please wait...
